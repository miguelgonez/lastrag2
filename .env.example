# ==============================================================
# LastRAG v2 — Variables de entorno
# ==============================================================
# Copia este archivo como .env y rellena los valores necesarios.
#   cp .env.example .env

# --- Selección de backend vectorial ---
# "gemini"  → cloud / SaaS (corpus sin PHI: guías públicas, papers, BOE)
# "qdrant"  → local-first / DGX (Nexthealth-OS, datos con PHI)
LASTRAG_BACKEND=gemini

# --- Backend Gemini (cloud) ---
GOOGLE_API_KEY=
GEMINI_STORE_NAME=lastrag-knowledge-base

# --- Backend Qdrant (local) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=lastrag
QDRANT_API_KEY=
QDRANT_VECTOR_SIZE=768

# --- Neo4j (LastIndex — árbol documental) ---
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j

# --- LLM de generación ---
# Modelo cloud (Gemini) por defecto; en DGX → modelo local
LASTRAG_GEN_MODEL=gemini-2.5-flash

# --- Endpoint LLM local (DGX — vLLM/TGI) ---
# LOCAL_LLM_ENDPOINT=http://localhost:8000/v1

# --- Política PHI ---
# true → bloquea cualquier backend con sends_data_to_cloud=True
LASTRAG_PHI_MODE=false
